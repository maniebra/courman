# Base path/URL the browser calls for the API. Defaults to same-origin "/api",
# which next.config.ts rewrites to BACKEND_URL (the actual Django server) so
# session cookies stay first-party and no CORS setup is needed.
NEXT_PUBLIC_API_URL=/api

# Where the Next.js dev server proxies /api/* to. Only read server-side.
BACKEND_URL=http://127.0.0.1:8000
